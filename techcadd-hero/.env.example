# Copy this file to `.env` and fill in the real values:
#
#   cp .env.example .env
#
# Next.js reads `.env` and `.env.local`; use `.env` so command-line tools see
# the same values the app does.
#
# Never commit `.env`. Never prefix a secret with NEXT_PUBLIC_: that would
# inline the value into the JavaScript bundle and publish it to every visitor.

# ---------------------------------------------------------------------------
# CMS — the public read/write API. Required.
# ---------------------------------------------------------------------------
# The blog, the student wall, the help centre and both enquiry forms all read
# from here. Point it at the CMS API's *public* prefix, not `/api`: everything
# under `/api` needs an admin session this site does not have.
#
# Read by server components and by the Book Demo route.
CMS_API_URL="http://localhost:4000/api/public"

# The same API as seen from the browser, for the course enquiry form and the
# newsletter subscribe box. Public by necessity — it is a plain URL with no
# secret in it.
NEXT_PUBLIC_CMS_API_URL="http://localhost:4000/api/public"

# ---------------------------------------------------------------------------
# Cache revalidation. Required in any environment where editors publish.
# ---------------------------------------------------------------------------
# The CMS posts to /api/revalidate with this value in `x-revalidate-secret`
# after every successful save, so a published change shows up immediately
# rather than waiting out this site's cache.
#
# It MUST match REVALIDATE_SECRET in the CMS API's own .env. Without it the
# endpoint refuses every request and content refreshes on its own hourly.
# Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
REVALIDATE_SECRET=""
