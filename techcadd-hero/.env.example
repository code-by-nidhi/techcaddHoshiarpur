# Copy this file to `.env` and fill in the real values:
#
#   cp .env.example .env
#
# Use `.env` rather than `.env.local` for DATABASE_URL. Next.js reads both, but
# the Prisma CLI (`prisma migrate`, `prisma studio`) only reads `.env` — putting
# the connection string in `.env.local` leaves migrations unable to find it.
#
# Never commit `.env`. Never prefix any of these with NEXT_PUBLIC_: that would
# inline the value into the JavaScript bundle and publish it to every visitor.

# ---------------------------------------------------------------------------
# MySQL — Book Demo enquiries. Server-only.
# ---------------------------------------------------------------------------
# Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# URL-encode the password if it contains @ : / ? # or % — for example a literal
# "p@ss" becomes "p%40ss".
#
# This must point at the SAME database as the server/ API's MYSQL_DATABASE_URL:
# both write the `demo_bookings` table, and a second database would split the
# lead pipeline in two.
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"

# ---------------------------------------------------------------------------
# Blog API (the NestJS service in ../server). Optional for the demo form.
# ---------------------------------------------------------------------------
# Read by server components.
BLOG_API_URL="http://localhost:4000/api"

# The same API as seen from the browser. Public by necessity — it is a plain
# URL with no secret in it.
NEXT_PUBLIC_BLOG_API_URL="http://localhost:4000/api"
