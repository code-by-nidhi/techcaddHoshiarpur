# Empty = the built-in procedural robot dog (no asset needed, ships working).
# Point at a GLB inside /public to use your own model:
NEXT_PUBLIC_ROBOT_MODEL_URL=

# Optional: the name of the head node/bone in that GLB, so cursor head
# tracking keeps working. Find it with:
#   npx gltfjsx public/models/robot-dog.glb
NEXT_PUBLIC_ROBOT_HEAD_NODE=
