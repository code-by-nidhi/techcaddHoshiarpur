// Demo requests ("Book Demo" enquiries) — MySQL.
//
// This model is mapped onto the existing `demo_bookings` table rather than a
// new one. That table already holds live leads written by the standalone
// NestJS API in ../server, and a second table would split the counselling
// team's pipeline in two. One table stays the single source of truth whichever
// service wrote the row.
//
// The column shapes below mirror server/prisma/mysql/schema.prisma exactly, so
// the two schemas describe the same table and neither drifts from it. If you
// change a column here, change it there too — or retire the Nest bookings
// module and let this schema own the table outright.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model DemoRequest {
  id Int @id @default(autoincrement())

  name String @db.VarChar(120)

  /// Ten digits, stored without the country code so it is easy to dial and to
  /// dedupe. Normalised by the API before it ever reaches here.
  phone String @db.VarChar(10)

  /// Not collected by the current modal, but the column exists and the Nest
  /// endpoint writes it, so the API accepts it when present.
  email String? @db.VarChar(254)

  /// The course the visitor picked. Nullable at the database level for
  /// backwards compatibility with older rows; the API requires it.
  course String? @db.VarChar(120)

  preferredDate String? @db.VarChar(32)
  message       String? @db.Text

  /// Which trigger opened the modal — navbar, hero, blog CTA. Attribution.
  source String @default("navbar") @db.VarChar(32)

  /// Lead lifecycle for the counselling team:
  /// "new" | "contacted" | "scheduled" | "closed".
  status String @default("new") @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the API's duplicate-submission guard, which looks up recent rows
  /// by number.
  @@index([phone])
  /// Serves the future admin panel: filter by status, sort by date.
  @@index([status, createdAt])
  @@map("demo_bookings")
}
