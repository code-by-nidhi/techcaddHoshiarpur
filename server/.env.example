# Blog data store. SQLite by default so the API runs with no service to
# provision; switch `provider` in prisma/schema.prisma to "postgresql" and drop
# a connection string here to move to Postgres without touching app code.
DATABASE_URL="file:./dev.db"

# Demo bookings (prisma/mysql/schema.prisma). Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
# The password must be URL-encoded if it contains @ : / ? # or %.
MYSQL_DATABASE_URL="mysql://root:PASSWORD@localhost:3306/techcadd"

# Where the API listens.
PORT=4000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Newsletter rate limit: requests per window, and window length in seconds.
NEWSLETTER_RATE_LIMIT=5
NEWSLETTER_RATE_TTL=60
