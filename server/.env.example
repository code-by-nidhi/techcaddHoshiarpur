# Data store. SQLite by default so the API runs with no service to provision;
# switch `provider` in prisma/schema.prisma to "postgresql" and drop a
# connection string here to move to Postgres without touching application code.
DATABASE_URL="file:./dev.db"

# Where the API listens.
PORT=4000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Newsletter rate limit: requests per window, and window length in seconds.
NEWSLETTER_RATE_LIMIT=5
NEWSLETTER_RATE_TTL=60
