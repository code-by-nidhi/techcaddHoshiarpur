// Data model for the TechCADD blog.
//
// SQLite is the default so the API runs with nothing to provision. Every field
// below is Postgres-compatible: switching `provider` to "postgresql" and
// pointing DATABASE_URL at a server is the only change needed. The two places
// that concession shows are `socialLinks` and `seoKeywords`, held as JSON/CSV
// strings because SQLite has no JSON or array column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Author {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  bio         String
  avatar      String
  role        String
  /// JSON object: { "linkedin": "...", "x": "...", "github": "..." }
  socialLinks String    @default("{}")
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  image       String?
  /// Controls the order of the pill row on the blog index.
  position    Int       @default(0)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  articles  Article[] @relation("ArticleTags")
  createdAt DateTime  @default(now())
}

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  /// Markdown-ish HTML, sanitised on write — never trusted on read.
  content       String
  featuredImage String
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  authorId      String
  author        Author    @relation(fields: [authorId], references: [id])
  tags          Tag[]     @relation("ArticleTags")
  /// "draft" | "published" | "archived" — a string because SQLite has no enum.
  status        String    @default("published")
  publishedAt   DateTime?
  readingTime   Int       @default(1)
  views         Int       @default(0)
  featured      Boolean   @default(false)
  trending      Boolean   @default(false)
  seoTitle      String?
  seoDescription String?
  /// Comma-separated keywords.
  seoKeywords   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([featured])
  @@index([trending])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  /// "active" | "unsubscribed"
  status       String   @default("active")
  source       String   @default("blog")
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
