// Demo bookings — MySQL.
//
// A second datasource, deliberately. The blog runs on the SQLite schema next
// door, and Prisma allows exactly one datasource per schema; splitting them
// means a MySQL outage costs you the booking form and nothing else, and the
// blog keeps serving. Consolidating later is a matter of moving this model
// across and pointing one DATABASE_URL at MySQL.

generator client {
  provider = "prisma-client-js"
  /// Generated into node_modules under its own package name, so application
  /// code imports it as "@prisma/mysql-client" rather than by relative path.
  /// A relative path breaks once the app is compiled: the emitted file sits in
  /// dist/ and the client does not.
  output   = "../../node_modules/@prisma/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

model DemoBooking {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(120)
  /// Ten digits, stored without the country code so it is easy to dial and to dedupe.
  phone         String   @db.VarChar(10)
  email         String?  @db.VarChar(254)
  /// Free text: the course the visitor is interested in.
  course        String?  @db.VarChar(120)
  preferredDate String?  @db.VarChar(32)
  message       String?  @db.Text
  /// Where the booking came from — navbar, hero, blog CTA.
  source        String   @default("navbar") @db.VarChar(32)
  /// "new" | "contacted" | "scheduled" | "closed", for the counselling team.
  status        String   @default("new") @db.VarChar(16)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([status, createdAt])
  @@map("demo_bookings")
}
